## @file
#  LmiTouchPower - power up the FTS touch panel, mux its I2C pins, self-test the
#  I2C link, and persist the transcript to the ESP (\\LMI_TX.TXT).
#
#  Depends only on the PMIC VREG protocol for dispatch ordering; the TLMM and I2C
#  protocols are looked up at runtime and skipped gracefully if absent.
##
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = LmiTouchPower
  FILE_GUID                      = 7f3c2a91-5b6e-4d84-9a17-3c8e5f2b9d41
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 2.0
  ENTRY_POINT                    = LmiTouchPowerEntry

[Sources]
  LmiTouchPower.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  Silicon/Qualcomm/QcomPkg/QcomPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  DebugLib
  BaseLib
  BaseMemoryLib
  PrintLib

[Protocols]
  gQcomPmicVregProtocolGuid
  gQcomTlmmProtocolGuid
  gQcomI2cProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  gEfiBlockIoProtocolGuid

[Guids]
  gEfiEventReadyToBootGuid

[Depex]
  #
  # Deliberately TRUE.  Waiting on gQcomPmicVregProtocolGuid looked correct but
  # on this firmware that protocol is never published, so the driver sat in the
  # dispatch queue forever: no console output, no power-up, Windows booted with a
  # dead panel.  Dispatch immediately and sequence the real work ourselves
  # (protocols are looked up at ReadyToBoot time, when everything exists).
  #
  TRUE
